{
  "name": "elo-connect",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @eloconnect/web",
    "build": "npm run build --workspace @eloconnect/shared && npm run build --workspace api && npm run build --workspace @eloconnect/web",
    "lint": "npm run lint --workspace api",
    "test": "npm run test --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "db:seed": "npm run db:seed --workspace api"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
