# Copie para .env (cp .env.example .env). Valores só de desenvolvimento:
# nunca coloque credenciais reais aqui (ver CONTRIBUTING.md).

# Banco local do docker-compose.yml da raiz. As migrations, o seed e os
# testes e2e usam esta mesma URL.
DATABASE_URL="postgresql://eloconnect:eloconnect@localhost:5432/eloconnect?schema=public"

# Porta da API. Em desenvolvimento, o Vite encaminha /api para http://localhost:3000.
PORT=3000

# Chave secreta utilizada para assinar e validar os tokens JWT (Validade de 1 hora)
JWT_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# Servidor SMTP para os e-mails transacionais (ex.: recuperação de senha).
# Em desenvolvimento, aponta para o Mailpit do docker-compose.yml, que guarda
# os e-mails na caixa de entrada http://localhost:8025 e não envia nada para
# fora. Em produção, os dados do provedor ficam só nas configurações da
# hospedagem, nunca no repositório.
SMTP_HOST="localhost"

# Porta do servidor SMTP (1025 no Mailpit; 587 ou 465 nos provedores)
SMTP_PORT=1025

# Conexão com TLS desde o início (true só na porta 465)
SMTP_SECURE=false

# Usuário e senha do provedor (vazios no Mailpit)
SMTP_USER=""
SMTP_PASSWORD=""

# Endereço de e-mail remetente padrão exibido nos disparos da aplicação
SMTP_FROM="Elo Connect <nao-responda@example.com>"

# URL base do front-end web utilizada para redirecionamentos e links em e-mails
WEB_URL="http://localhost:5173"

# true: escreve os e-mails no log da API em vez de enviar. Só para a
# demonstração, que não tem SMTP (docs/deploy.md). Em desenvolvimento, fica
# false e os e-mails vão para o Mailpit.
EMAIL_SO_NO_LOG=false

# Pasta dos PDFs das convenções em desenvolvimento (relativa a apps/api). Na
# hospedagem, os PDFs ficam no Vercel Blob privado: a Vercel cria a variável
# BLOB_STORE_ID quando o armazenamento é ligado ao projeto (docs/deploy.md), e
# aí esta pasta não é usada.
ARQUIVOS_DIR="arquivos"
