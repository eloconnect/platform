# Copie para .env (cp .env.example .env). Valores só de desenvolvimento:
# nunca coloque credenciais reais aqui (ver CONTRIBUTING.md).

# Banco local do docker-compose.yml da raiz. As migrations, o seed e os
# testes e2e usam esta mesma URL.
DATABASE_URL="postgresql://eloconnect:eloconnect@localhost:5432/eloconnect?schema=public"

# Porta da API. Em desenvolvimento, o Vite encaminha /api para http://localhost:3000.
PORT=3000

# Chave secreta utilizada para assinar e validar os tokens JWT (Validade de 1 hora)
JWT_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# Servidor SMTP para envio de e-mails transacionais (ex: recuperação de senha)
SMTP_HOST="smtp.example.com"

# Porta utilizada pelo servidor SMTP (ex: 587 para TLS ou 465 para SSL)
SMTP_PORT=587

# Define se a conexão SMTP utiliza canal seguro (true/false)
SMTP_SECURE=false

# Nome de usuário ou e-mail de autenticação no servidor SMTP
SMTP_USER=""

# Senha de acesso correspondente à conta SMTP
SMTP_PASSWORD=""

# Endereço de e-mail remetente padrão exibido nos disparos da aplicação
SMTP_FROM="Elo Connect <nao-responda@example.com>"

# URL base do front-end web utilizada para redirecionamentos e links em e-mails
WEB_URL="http://localhost:5173"