DATABASE_URL="postgresql://eloconnect:eloconnect@127.0.0.1:5432/eloconnect?schema=public"
PORT=3000
WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=
COOKIE_SECURE=false

# Optional local/test-only OTP bypass. Never configure this in production.
# Comma-separated exact e-mail addresses; requires NODE_ENV=development or test.
AUTH_OTP_BYPASS_EMAILS=

# Configure SMTP before enabling password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only by the one-time provision-user script; do not commit real values.
PROVISION_EMAIL=
PROVISION_PASSWORD=
PROVISION_ROLE=ADMIN
