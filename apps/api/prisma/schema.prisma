// Schema do banco do Elo Connect.
// Documentação, diagrama e decisões: docs/modelo-dados.md.
// Nomes em português, iguais ao glossário de docs/requisitos.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Acesso
// ---------------------------------------------------------------------------

/// Dois perfis da sede (RN33): ADMIN é o chave mestre, com todas as funções;
/// ADMIN_BASICO publica conteúdo e consulta associados.
enum Perfil {
  ADMIN
  ADMIN_BASICO
  ASSOCIADO
}

/// Conta de acesso. Admin é funcionário da sede; associado é a conta da
/// farmácia, também usada pelo contador (RN29).
model Usuario {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique
  /// Nulo enquanto o associado não cria a senha pelo link do e-mail (RF05).
  senhaHash         String?
  nome              String
  perfil            Perfil
  ativo             Boolean   @default(true)
  emailConfirmadoEm DateTime?
  /// Só para perfil ASSOCIADO: uma conta por farmácia (RN29).
  associadoId       String?   @unique @db.Uuid
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  associado              Associado?                @relation(fields: [associadoId], references: [id], onDelete: Restrict)
  tokens                 TokenUsuario[]
  valoresAlterados       ValorContribuicao[]
  transacoes             Transacao[]
  logs                   LogAuditoria[]
  convencoes             Convencao[]
  noticias               Noticia[]
  cancelamentosDecididos SolicitacaoCancelamento[]
  adesoes                AdesaoCobranca[]
}

enum TipoToken {
  RECUPERACAO_SENHA
  CONFIRMACAO_EMAIL
}

/// Tokens de uso único enviados por e-mail (RF03, RF04). Guarda só o hash.
model TokenUsuario {
  id        String    @id @default(uuid(7)) @db.Uuid
  usuarioId String    @db.Uuid
  tipo      TipoToken
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// Associados
// ---------------------------------------------------------------------------

enum SituacaoAssociado {
  ADIMPLENTE
  INADIMPLENTE
}

/// Decisão manual da sede, que prevalece sobre a situação automática (RN11).
enum AcessoManual {
  LIBERADO
  BLOQUEADO
}

/// Farmácia ou drogaria do universo do sindicato (~2.000). Pode existir sem
/// conta de acesso (ex.: importada para a cobrança formal).
model Associado {
  id                     String            @id @default(uuid(7)) @db.Uuid
  /// Só dígitos, sem máscara.
  cnpj                   String            @unique @db.Char(14)
  // Campos cadastrais provisórios: dependem do arquivo da JUCEMAT (P02) e da
  // planilha da carga inicial (RF42). Novos campos entram por migration.
  razaoSocial            String
  nomeFantasia           String?
  email                  String?
  telefone               String?
  municipio              String?
  /// "Recebe boleto mensal: sim/não" no painel da sede (RN22, RN23, RN25).
  contribuicaoAtiva      Boolean           @default(false)
  /// Quando a sede interrompeu a cobrança recorrente (RN25). O associado em
  /// dia mantém o acesso por mais 30 dias. Volta a nulo quando a cobrança
  /// é ativada de novo.
  cobrancaInterrompidaEm DateTime?
  /// Situação automática: o pagamento torna ADIMPLENTE, o vencimento sem
  /// pagamento torna INADIMPLENTE (RN09, RN10).
  situacao               SituacaoAssociado @default(INADIMPLENTE)
  /// Nulo = segue a situação automática (RN11).
  acessoManual           AcessoManual?
  /// Fim da liberação manual, 7 dias depois dela (RN11). Nulo no bloqueio,
  /// que vale até a sede mudar. Conferido na hora, sem job.
  acessoManualAte        DateTime?
  /// Inativação manual pela sede (RF08). Não há exclusão de associado.
  inativadoEm            DateTime?
  criadoEm               DateTime          @default(now())
  atualizadoEm           DateTime          @updatedAt

  usuario       Usuario?
  boletos       Boleto[]
  transacoes    Transacao[]
  logs          LogAuditoria[]
  cancelamentos SolicitacaoCancelamento[]
  edicoesBoleto EdicaoBoleto[]
  adesoes       AdesaoCobranca[]

  @@index([situacao])
  @@index([contribuicaoAtiva])
}

enum StatusCancelamento {
  PENDENTE
  APROVADA
  RECUSADA
}

/// Pedido de cancelamento da cobrança recorrente, validado pela sede (RN18).
model SolicitacaoCancelamento {
  id             String             @id @default(uuid(7)) @db.Uuid
  associadoId    String             @db.Uuid
  status         StatusCancelamento @default(PENDENTE)
  motivo         String?
  observacaoSede String?
  solicitadaEm   DateTime           @default(now())
  decididaEm     DateTime?
  decididaPorId  String?            @db.Uuid

  associado   Associado @relation(fields: [associadoId], references: [id], onDelete: Restrict)
  decididaPor Usuario?  @relation(fields: [decididaPorId], references: [id], onDelete: Restrict)

  @@index([associadoId, status])
}

// ---------------------------------------------------------------------------
// Cobrança
// ---------------------------------------------------------------------------

/// Histórico imutável de valores (RN01, RN13 a RN16, RF18 a RF20).
/// O valor atual é o registro mais recente; o anterior é o registro de antes.
/// O boleto de um mês usa o registro mais recente criado antes do início desse
/// mês, no horário de Mato Grosso (RN15).
model ValorContribuicao {
  id            String   @id @default(uuid(7)) @db.Uuid
  valorMensal   Decimal  @db.Decimal(10, 2)
  /// Plano anual à vista, calculado a partir do mensal (RN13, RF18) e guardado
  /// junto, para o histórico mostrar o que valia (P23).
  valorAnual    Decimal  @db.Decimal(10, 2)
  alteradoPorId String   @db.Uuid
  criadoEm      DateTime @default(now())

  alteradoPor Usuario @relation(fields: [alteradoPorId], references: [id], onDelete: Restrict)
}

enum StatusLote {
  /// Gerado, com boletos ainda por emitir no banco.
  RASCUNHO
  /// Todos os boletos emitidos.
  ENVIADO
}

/// Lote mensal de boletos: gerado e enviado sozinho no primeiro dia útil, sem
/// revisão da sede (RN04, RF10).
model LoteMensal {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Primeiro dia do mês de referência.
  competencia DateTime   @unique @db.Date
  status      StatusLote @default(RASCUNHO)
  geradoEm    DateTime   @default(now())
  enviadoEm   DateTime?

  boletos Boleto[]
}

enum TipoBoleto {
  /// Cobrança recorrente, gerada no lote mensal.
  MENSAL
  /// Pagamento de um único mês (RN24). Regras em P10.
  AVULSO
  /// Plano anual à vista (RN13). Regras em P04.
  ANUAL
}

enum StatusBoleto {
  RASCUNHO
  /// Emitido no Sicredi e enviado ao associado. Vencido = EM_ABERTO com
  /// vencimento no passado (calculado, não guardado).
  EM_ABERTO
  PAGO
  CANCELADO
  /// Passou da validade de 30 dias depois do vencimento sem pagamento
  /// (RN03, RN09). O banco não recebe mais este boleto.
  EXPIRADO
}

model Boleto {
  id                 String       @id @default(uuid(7)) @db.Uuid
  associadoId        String       @db.Uuid
  /// Nulo para boletos fora do lote mensal (avulso e anual: P10, P04).
  loteId             String?      @db.Uuid
  tipo               TipoBoleto
  /// Primeiro dia do mês de referência.
  competencia        DateTime     @db.Date
  valor              Decimal      @db.Decimal(10, 2)
  /// Dia 10 do mês (RN02).
  vencimento         DateTime     @db.Date
  status             StatusBoleto @default(RASCUNHO)
  // Dados do Sicredi: provisórios até o estudo da API (#40).
  sicrediNossoNumero String?      @unique
  linhaDigitavel     String?
  pixCopiaECola      String?
  emitidoEm          DateTime?
  /// Quando o e-mail com o boleto saiu para o associado (RF12). Nulo
  /// enquanto não saiu: a próxima execução do lote tenta de novo.
  emailEnviadoEm     DateTime?
  pagoEm             DateTime?
  /// Quando saiu o último lembrete: 2 dias antes do vencimento e, depois
  /// dele, um por semana (RF13, RF14, RN07).
  ultimoLembreteEm   DateTime?
  criadoEm           DateTime     @default(now())
  atualizadoEm       DateTime     @updatedAt

  associado  Associado   @relation(fields: [associadoId], references: [id], onDelete: Restrict)
  lote       LoteMensal? @relation(fields: [loteId], references: [id], onDelete: Restrict)
  transacoes Transacao[]

  @@index([associadoId, competencia])
  @@index([status, vencimento])
}

/// Adesão à cobrança recorrente pelo próprio associado (RN23), com o aceite
/// do termo: a data, a hora e a versão do termo aceito (resposta 19).
/// Imutável, como prova do aceite (trigger da migration adesao_cobranca).
model AdesaoCobranca {
  id          String   @id @default(uuid(7)) @db.Uuid
  associadoId String   @db.Uuid
  /// A conta que aceitou. O contador entra com a conta do associado (RN29).
  usuarioId   String   @db.Uuid
  versaoTermo String
  aceitaEm    DateTime @default(now())

  associado Associado @relation(fields: [associadoId], references: [id], onDelete: Restrict)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([associadoId, aceitaEm])
}

/// Valor do boleto mensal de um associado mudado pela sede para um mês só
/// (RN04, RF11). A edição feita num mês vale para o boleto do mês seguinte, e
/// os outros meses seguem o valor da contribuição. Quem editou e quando ficam
/// no log de auditoria; voltar ao valor normal apaga a edição.
model EdicaoBoleto {
  id           String   @id @default(uuid(7)) @db.Uuid
  associadoId  String   @db.Uuid
  /// Primeiro dia do mês do boleto editado.
  competencia  DateTime @db.Date
  valor        Decimal  @db.Decimal(10, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  associado Associado @relation(fields: [associadoId], references: [id], onDelete: Restrict)

  @@unique([associadoId, competencia])
}

enum EventoTransacao {
  GERADO
  EDITADO
  EMITIDO
  PAGO
  CANCELADO
  EXPIRADO
}

enum FormaPagamento {
  BOLETO
  PIX
}

/// Histórico imutável de transações, usado como prova em divergências
/// (RN17, RF30). Cada mudança de um boleto gera um registro novo.
model Transacao {
  id                 String          @id @default(uuid(7)) @db.Uuid
  boletoId           String          @db.Uuid
  associadoId        String          @db.Uuid
  evento             EventoTransacao
  /// Cópia dos dados do boleto no momento do evento.
  valor              Decimal         @db.Decimal(10, 2)
  sicrediNossoNumero String?
  formaPagamento     FormaPagamento?
  /// Nulo = ação automática do sistema.
  usuarioId          String?         @db.Uuid
  detalhes           Json?
  ocorridoEm         DateTime        @default(now())

  boleto    Boleto    @relation(fields: [boletoId], references: [id], onDelete: Restrict)
  associado Associado @relation(fields: [associadoId], references: [id], onDelete: Restrict)
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([associadoId, ocorridoEm])
  @@index([boletoId])
}

// ---------------------------------------------------------------------------
// Auditoria
// ---------------------------------------------------------------------------

/// Log imutável de toda ação dos usuários da sede (RN26, RF39, RF40).
model LogAuditoria {
  id            String   @id @default(uuid(7)) @db.Uuid
  usuarioId     String   @db.Uuid
  /// Ex.: ASSOCIADO_EDITADO, LOTE_ENVIADO. O catálogo fica em
  /// packages/shared (#15).
  acao          String
  /// Nome do modelo afetado (ex.: Associado) e o id do registro.
  entidade      String
  entidadeId    String?
  /// Preenchido quando a ação envolve um associado, para o filtro do RF40.
  associadoId   String?  @db.Uuid
  valorAnterior Json?
  valorNovo     Json?
  ocorridoEm    DateTime @default(now())

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  associado Associado? @relation(fields: [associadoId], references: [id], onDelete: Restrict)

  @@index([usuarioId, ocorridoEm])
  @@index([associadoId, ocorridoEm])
  @@index([acao, ocorridoEm])
}

// ---------------------------------------------------------------------------
// Conteúdo
// ---------------------------------------------------------------------------

/// Convenção coletiva (RF21, RF22). Inscrição em convenção fica fora até P05.
model Convencao {
  id             String    @id @default(uuid(7)) @db.Uuid
  titulo         String
  ano            Int
  resumo         String    @db.Text
  /// Tabela de reajuste salarial. Formato livre até a primeira convenção real.
  tabelaReajuste Json?
  /// Nulo = rascunho, não aparece para os associados.
  publicadaEm    DateTime?
  autorId        String    @db.Uuid
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  autor  Usuario          @relation(fields: [autorId], references: [id], onDelete: Restrict)
  anexos ConvencaoAnexo[]

  @@index([ano])
}

/// Feed de notícias, visível a qualquer associado logado (RN28, RF35, RF41).
model Noticia {
  id              String    @id @default(uuid(7)) @db.Uuid
  titulo          String
  conteudo        String    @db.Text
  /// Imagem opcional (RF41): caminho no armazenamento privado. Nunca vai para
  /// as telas; a imagem sai pela API, só para quem está logado (RN28).
  imagemCaminho   String?
  /// Nome do arquivo que a sede enviou, para o log de auditoria.
  imagemNome      String?
  /// Descrição da imagem para quem usa leitor de tela (RNF02). Opcional.
  imagemDescricao String?
  /// Nulo = rascunho.
  publicadaEm     DateTime?
  /// Remoção lógica: o registro fica para o log de auditoria.
  removidaEm      DateTime?
  autorId         String    @db.Uuid
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  autor Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@index([publicadaEm])
}

/// Os dois grupos de benefícios (RN32). A regra de acesso de cada um depende
/// da P15.
enum GrupoBeneficio {
  ASSESSORIA_JURIDICA
  CONSULTORIA
}

/// Benefício exibido no app e na landing page (RF24). Lista real em P06.
model Beneficio {
  id           String         @id @default(uuid(7)) @db.Uuid
  titulo       String
  descricao    String         @db.Text
  grupo        GrupoBeneficio
  /// Remover desliga o benefício, e o registro fica para o log (RN26).
  ativo        Boolean        @default(true)
  ordem        Int            @default(0)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
}

/// Tipo de PDF anexado à convenção coletiva.
enum TipoAnexoConvencao {
  INTEGRAL
  RESUMIDA
}

/// PDF anexado a uma convenção, armazenado em serviço privado.
model ConvencaoAnexo {
  id           String             @id @default(uuid(7)) @db.Uuid
  convencaoId  String             @db.Uuid
  tipo         TipoAnexoConvencao
  nomeArquivo  String
  arquivoUrl   String
  tamanhoBytes Int
  criadoEm     DateTime           @default(now())

  convencao Convencao @relation(fields: [convencaoId], references: [id], onDelete: Cascade)

  /// Um PDF de cada tipo por convenção.
  @@unique([convencaoId, tipo])
  @@index([convencaoId])
}
